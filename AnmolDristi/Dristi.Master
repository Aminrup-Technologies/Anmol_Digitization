    <script src="Resources/Scripts/jquery-1.7.2.min.js"></script>
    <script type="text/javascript">
        var idleTimeout;
        var logoutTime;

        function startIdleTimer() {
            idleTimeout = setTimeout(function () {
                location.href = 'login.aspx';
            }, 10 * 60 * 1000); // 5 minutes in milliseconds

            // Calculate the logout time
            logoutTime = new Date();
            logoutTime.setMinutes(logoutTime.getMinutes() + 10); // Adding 5 minutes to the current time

            // Update the display
            updateDisplay();
        }

        function resetIdleTimer() {
            clearTimeout(idleTimeout);
            startIdleTimer();
        }

        function handleUserActivity() {
            resetIdleTimer();
        }

        function updateDisplay() {
            var dt = new Date();
            var currentTimeLabel = document.getElementById("lblTime");
            var logoutTimeLabel = document.getElementById("lblTime1");

            // Display current time
            currentTimeLabel.innerHTML = dt.toLocaleTimeString();

            // Calculate time left until auto logout
            var timeLeft = Math.max(0, (logoutTime - dt) / 1000); // Time left in seconds
            var minutesLeft = Math.floor(timeLeft / 60);
            var secondsLeft = Math.floor(timeLeft % 60);
            var timeLeftString = (minutesLeft < 10 ? "0" : "") + minutesLeft + ":" + (secondsLeft < 10 ? "0" : "") + secondsLeft;
            logoutTimeLabel.innerHTML = timeLeftString;

            // If we've reached 0 minutes and 0 seconds, initiate logout
            if (timeLeft <= 0) {
                location.href = 'login.aspx';
                return;
            }
        }

        $(document).ready(function () {
            startIdleTimer();
            setInterval(updateDisplay, 1000);
            document.addEventListener("mousemove", handleUserActivity);
            document.addEventListener("keypress", handleUserActivity);
        });

        // run this on pages where the user is logged in (master page)
        //(function () {
        //    var HEARTBEAT_MINUTES = 5;
        //    var HEARTBEAT_MS = HEARTBEAT_MINUTES * 60 * 1000;

        //    function sendHeartbeat() {
        //        try {
        //            var id = sessionStorage.getItem('ActiveSessionId');
        //            if (!id) return;

        //            $.ajax({
