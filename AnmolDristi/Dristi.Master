    <style type="text/css">
        /* 1. Hide the hamburger toggle completely */
        #menu_toggle { display: none !important; }

        /* 2. KILL THE FLYOUTS: Completely hide the default floating menus globally */
        body.nav-sm .nav.child_menu, 
        body.nav-sm .active-sm {
            display: none !important; 
        }

        /* 3. Lock main content so it NEVER jumps when the sidebar expands */
        body.nav-md .container.body .right_col,
        body.nav-sm .container.body .right_col {
            margin-left: 70px !important; /* Always leave room for the narrow bar */
            width: auto !important; 
            padding: 10px 20px !important;
            z-index: 1;
        }

        /* 4. Make the sidebar float OVER the content when it expands */
        .col-md-3.left_col {
            position: fixed !important; 
            z-index: 9999 !important;
            height: 100vh !important;
            overflow-y: auto !important;
            transition: width 0.2s ease; /* Smooth expanding animation */
        }
        
        /* 5. Fix top navigation padding */
        .nav_menu { width: 100%; margin-bottom: 0; }
        
        /* 6. Hide ANMOL text in narrow mode */
        body.nav-sm .site_title span { display: none !important; }
        body.nav-sm .nav_title { width: 70px !important; }
    </style>
