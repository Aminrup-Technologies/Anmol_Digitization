<?xml version="1.0" encoding="utf-8"?>
<!-- Apply with a UAT publish profile, or merge manually when deploying to appsuat.anmolindustries.com -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="VmsPublicBaseUrl"
         value="https://appsuat.anmolindustries.com"
         xdt:Transform="SetAttributes"
         xdt:Locator="Match(key)" />
  </appSettings>
</configuration>
