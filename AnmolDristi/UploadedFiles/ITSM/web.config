<?xml version="1.0" encoding="utf-8"?>
<!--
    When: 2026-11-26
    What: Deny all HTTP handler access to the ITSM attachment storage folder.
    Why: Ticket files must be delivered only by DownloadAttachment.ashx,
         after application-level ticket and company authorization. This
         restriction affects HTTP requests, not application-pool file I/O.
    The site authorization collection already has an entry keyed by
    users="*". Clear that inherited entry, then deny every user.
-->
<configuration>
  <system.web>
    <authorization>
      <deny users="*" />
    </authorization>
  </system.web>
  <system.webServer>
    <handlers accessPolicy="None" />
    <security>
      <authorization>
        <clear />
        <add accessType="Deny" users="*" />
      </authorization>
    </security>
  </system.webServer>
</configuration>
